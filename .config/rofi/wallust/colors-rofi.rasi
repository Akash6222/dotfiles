* {
active-background: #10161E;
active-foreground: #E5DAD4;
normal-background: #151617;
normal-foreground: #E5DAD4;
urgent-background: #676C78;
urgent-foreground: #E5DAD4;

alternate-active-background: #52565E;
alternate-active-foreground: #E5DAD4;
alternate-normal-background: #151617;
alternate-normal-foreground: #E5DAD4;
alternate-urgent-background: #151617;
alternate-urgent-foreground: #E5DAD4;

selected-active-background: #10161E;
selected-active-foreground: #E5DAD4;
selected-normal-background: #D2C1BA;
selected-normal-foreground: #E5DAD4;
selected-urgent-background: #676C78;
selected-urgent-foreground: #E5DAD4;

background-color: #151617;
